      "description": "Nouns - Feminine (3rd declension -a/-ya)",
      "suffixes": [
        "а", "ы", "е", "у", "ой", "ою", "и", "я", "ь", "ю", "ей", "ею",
        "ам", "ами", "ах", "ям", "ями", "ях"
      ]
    },
    {
      "description": "Adjectives (Hard and Soft)",
      "suffixes": [
        "ый", "ая", "ое", "ые", "ого", "ому", "ым", "ом", "ую", "ой",
        "ых", "ыми", "ий", "яя", "ее", "ие", "его", "ему", "им", "ем",
        "юю", "их", "ими"
      ]
    },
